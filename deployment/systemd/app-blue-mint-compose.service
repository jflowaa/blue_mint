[Unit]
Description=blue-mint compose stack
Wants=network-online.target
After=network-online.target platform-compose.service
Requires=platform-compose.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/apps/blue-mint
ExecStart=/usr/bin/podman-compose -p blue-mint up -d --remove-orphans
ExecStop=/usr/bin/podman-compose -p blue-mint down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
